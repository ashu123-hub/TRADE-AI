# TradeMind AI - Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# YAHOO FINANCE (yfinance & Optional API Key)
# Primary real-time & historical market data provider for NSE.
# Works out-of-the-box with zero keys required for standard yfinance.
# Optional: RapidAPI or Yahoo Finance API key for elevated rate limits.
# ─────────────────────────────────────────────
YAHOO_FINANCE_ENABLED=true

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# FINNHUB (Primary Market Data & News)
# Get your free API key at: https://finnhub.io/
# ─────────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-api-key-here

# ─────────────────────────────────────────────
# ALPHA VANTAGE (Primary Historical Data)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
# ─────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here

# ─────────────────────────────────────────────
# GOOGLE GEMINI
# Get your free API key at: https://aistudio.google.com/
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
